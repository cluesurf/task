{
  "name": "@termsurf/task-host",
  "version": "0.0.3",
  "type": "module",
  "main": "./host/index.js",
  "scripts": {
    "make": "tsc && tsc-alias",
    "move": "pnpm make && git add . && git commit -am 'save' && npm version patch && pnpm host && git push",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "host": "rm -rf host && mkdir host && find code -name '*.wasm' | cpio -pdm host ; pnpm make && npm publish --access=public"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bytes": "^3.1.4",
    "@types/flat": "^5.0.5",
    "@types/lodash": "^4.14.191",
    "@types/memorystream": "^0.3.4",
    "@types/node": "^18.11.18",
    "@types/node-forge": "^1.3.11",
    "@types/prettier": "^2.7.2",
    "@types/replace-ext": "^2.0.2",
    "@types/sanitize-html": "^2.9.5",
    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "autoprefixer": "^10.4.16",
    "csstype": "^3.1.1",
    "eslint": "8.32.0",
    "eslint-config-next": "13.1.5",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-standard-with-typescript": "^27.0.1",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.4",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "eslint-plugin-sort-exports": "^0.8.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-typescript-sort-keys": "^2.1.0",
    "postcss": "^8.5.23",
    "postcss-preset-env": "^9.3.0",
    "prettier": "^2.8.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0"
  }
}
