# Maintainer: __MAINTAINER__
pkgname=__NAME__
pkgver=__VERSION__
pkgrel=0
pkgdesc="__SUMMARY__"
url="__HOMEPAGE__"
arch="noarch"
license="__LICENSE__"
depends="__DEPS__"
options="!check"
source=""

package() {
  # metapackage — owns no files. Just create the empty pkgdir so
  # abuild's postcheck doesn't complain.
  mkdir -p "$pkgdir"
}
