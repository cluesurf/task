{
  "name": "@termsurf/hack",
  "version": "0.0.1",
  "chocoVersion": "0.0.2",
  "bin": {
    "task": "./host/code/cli/index.js"
  },
  "scripts": {
    "test:clean": "rm -rf test/hold && mkdir test/hold && mkdir test/hold/pdf",
    "test:cli": "pnpm test:clean && ./test/cli.sh",
    "test:node": "pnpm test:clean && pnpm tsx ./test/node",
    "test:browser": "open http://localhost:3000",
    "bump:choco": "pnpm tsx bump.choco",
    "bind:dock": "source .env && echo $GITHUB_TOKEN | docker login ghcr.io -u $GITHUB_USERNAME --password-stdin",
    "make:dock": "source .env && docker build --progress plain --platform linux/amd64 . -t cluesurf/task && pnpm mark:dock",
    "make:dock:show": "source .env && docker build --progress plain --platform linux/amd64 . -t cluesurf/task && pnpm mark:dock",
    "host:dock": "pnpm mark:dock && source .env && docker push ghcr.io/cluesurf/task:latest",
    "mark:dock": "source .env && docker tag cluesurf/task:latest ghcr.io/cluesurf/task:latest",
    "rise:dock": "source .env && docker run --platform linux/amd64 --name task -d -i -t cluesurf/task bash",
    "call:dock": "docker exec -d base",
    "hook:dock": "docker exec -it base bash",
    "kill:dock": "docker kill base",
    "toss:dock": "docker rm base",
    "size:dock": "source ./hook.sh && print_bytes $(docker inspect -f \"{{ .Size }}\" cluesurf/task)",
    "make": "tsc && tsc-alias",
    "make:type": "pnpm tsx make",
    "move": "pnpm make && git add . && git commit -am 'save' && npm version patch && pnpm host && git push",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "host": "rm -rf host && mkdir host && find code -name '*.wasm' | cpio -pdm host ; pnpm make && pnpm make:puppeteer && npm publish --access=public",
    "make:puppeteer": "webpack build --config webpack.puppeteer.config.js",
    "scan:puppeteer": "webpack watch --config webpack.puppeteer.config.js",
    "make:test": "webpack build --config webpack.test.config.mjs",
    "scan:test": "webpack watch --config webpack.test.config.mjs",
    "test:bind": "pnpm tsx test/server.ts",
    "load:form": "pnpm remove @cluesurf/form && pnpm add @cluesurf/form@latest"
  },
