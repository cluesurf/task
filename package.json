  "scripts": {
    "test:clean": "rm -rf test/hold && mkdir test/hold && mkdir test/hold/pdf",
    "test:cli": "pnpm test:clean && ./test/cli.sh",
    "test:node": "pnpm test:clean && pnpm tsx ./test/node",
    "test:browser": "open http://localhost:3000",
    "bump:choco": "pnpm tsx bump.choco",
    "dotenv": "sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/export \\1=\\2/p' .env",
    "with-env": "./make/deck/with-env.sh",
    "docker:login": "source .env && echo $GITHUB_TOKEN | docker login ghcr.io -u $GITHUB_USERNAME --password-stdin",
    "docker:build": "source .env && docker build --progress plain --platform linux/amd64 . -t cluesurf/task && pnpm docker:tag",
    "docker:tag": "source .env && docker tag cluesurf/task:latest ghcr.io/cluesurf/task:latest",
    "docker:push": "pnpm docker:tag && source .env && docker push ghcr.io/cluesurf/task:latest",
    "docker:run": "source .env && docker run --platform linux/amd64 --name task -d -i -t cluesurf/task bash",
    "docker:exec": "docker exec -d task",
    "docker:shell": "docker exec -it task bash",
    "docker:kill": "docker kill task",
    "docker:rm": "docker rm task",
    "docker:size": "source ./hook.sh && print_bytes $(docker inspect -f \"{{ .Size }}\" cluesurf/task)",
    "make": "tsc && tsc-alias",
    "make:type": "pnpm tsx make",
    "move": "pnpm make && git add . && git commit -am 'save' && npm version patch && pnpm host && git push",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "host": "rm -rf host && mkdir host && find code -name '*.wasm' | cpio -pdm host ; pnpm make && pnpm make:puppeteer && npm publish --access=public",
    "make:puppeteer": "webpack build --config webpack.puppeteer.config.js",
    "scan:puppeteer": "webpack watch --config webpack.puppeteer.config.js",
    "make:test": "webpack build --config webpack.test.config.mjs",
    "scan:test": "webpack watch --config webpack.test.config.mjs",
    "test:bind": "pnpm tsx test/server.ts",
    "test:smoke": "docker build --platform linux/amd64 -f test/Dockerfile.test --build-arg BASE_IMAGE=ghcr.io/cluesurf/task:latest --build-arg TASK_VERSION=$npm_package_version -t cluesurf-task-smoke . && docker run --rm cluesurf-task-smoke",
    "test:smoke:local": "docker build --platform linux/amd64 . -t cluesurf/task:local && docker build --platform linux/amd64 -f test/Dockerfile.test --build-arg BASE_IMAGE=cluesurf/task:local --build-arg TASK_VERSION=$npm_package_version -t cluesurf-task-smoke . && docker run --rm cluesurf-task-smoke",
    "test:smoke:apt": "docker run --rm --platform linux/amd64 ubuntu:24.04 bash -c 'apt update && apt install -y curl gnupg ca-certificates && curl -fsSL https://deck.clue.surf/task/apt/pubkey.asc | gpg --dearmor -o /usr/share/keyrings/cluesurf.gpg && echo \"deb [signed-by=/usr/share/keyrings/cluesurf.gpg] https://deck.clue.surf/task/apt stable main\" > /etc/apt/sources.list.d/cluesurf.list && apt update && apt install -y cluesurf-task && command -v ffmpeg >/dev/null'",
    "test:smoke:rpm": "docker run --rm --platform linux/amd64 fedora:latest bash -c 'rpm --import https://deck.clue.surf/task/rpm/pubkey.asc && cat <<EOF >/etc/yum.repos.d/cluesurf.repo\n[cluesurf]\nname=ClueSurf\nbaseurl=https://deck.clue.surf/task/rpm\nenabled=1\ngpgcheck=1\ngpgkey=https://deck.clue.surf/task/rpm/pubkey.asc\nEOF\ndnf install -y cluesurf-task && command -v ffmpeg >/dev/null'",
    "test:smoke:apk": "docker run --rm --platform linux/amd64 alpine:latest sh -c 'echo https://deck.clue.surf/task/apk >> /etc/apk/repositories && wget -O /etc/apk/keys/cluesurf.rsa.pub https://deck.clue.surf/task/apk/cluesurf.rsa.pub && apk update && apk add cluesurf-task && command -v ffmpeg >/dev/null'",
    "load:form": "pnpm remove @cluesurf/form && pnpm add @cluesurf/form@latest",
    "sync:vers": "./make/deck/sync-versions.sh",
    "make:pkg": "cd make/deck && ./make.sh",
    "make:pkg:linux": "cd make/deck && ./linux/docker-build.sh",
    "make:pkg:windows": "cd make/deck && ./make.sh scoop winget choco",
    "make:pkg:nix": "cd make/deck && ./make.sh nix",
    "host:pkg": "./make/deck/with-env.sh ./make/deck/publish.sh",
    "host:pkg:deb": "./make/deck/with-env.sh ./make/deck/publish.sh deb",
    "host:pkg:rpm": "./make/deck/with-env.sh ./make/deck/publish.sh rpm",
    "host:pkg:arch": "./make/deck/with-env.sh ./make/deck/publish.sh arch",
    "host:pkg:alpine": "./make/deck/with-env.sh ./make/deck/publish.sh alpine",
    "alpine": "./make/deck/linux/alpine/run.sh",
    "alpine:make": "./make/deck/linux/alpine/run.sh ./make.sh",
    "alpine:publish": "./make/deck/linux/alpine/run.sh ./publish.sh",
    "host:pkg:opensuse": "./make/deck/with-env.sh ./make/deck/publish.sh opensuse",
    "host:pkg:gentoo": "./make/deck/with-env.sh ./make/deck/publish.sh gentoo",
    "host:pkg:scoop": "./make/deck/with-env.sh ./make/deck/publish.sh scoop",
    "host:pkg:winget": "./make/deck/with-env.sh ./make/deck/publish.sh winget",
    "host:pkg:choco": "./make/deck/with-env.sh ./make/deck/publish.sh choco",
    "host:pkg:nix": "./make/deck/with-env.sh ./make/deck/publish.sh nix",
    "host:gh": "gh release create v$npm_package_version --generate-notes make/deck/windows/winget/dist/cluesurf-task.zip",
    "host:cask": "cd ../homebrew-code && git add Casks/task.rb && git commit -m \"task $npm_package_version\" && git push",
    "host:site": "cd ../deck && git add docs/task && git commit -m \"task $npm_package_version\" && git push",
    "release:build": "pnpm test && pnpm make && pnpm docker:build && pnpm make:pkg && pnpm make:pkg:linux",
    "release:host": "pnpm host && pnpm docker:push && pnpm host:gh && pnpm host:pkg && pnpm host:site && pnpm host:cask",
    "release": "pnpm release:build && pnpm release:host",
    "release:hotfix": "pnpm version patch && pnpm sync:vers && pnpm release"
  },
